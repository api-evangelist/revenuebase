          "id": "8239e151-6a18-446e-8433-ed51e36877ee",
          "name": "Download batch job results",
          "request": {
            "name": "Download batch job results",
            "description": {
              "content": "Streams the processed output file for a completed or cancelled batch job. The response includes a `Content-Disposition` header with the original filename.\n\n**Errors**\n- `400 not_completed` — Job must be `COMPLETED` or `CANCELLED` before downloading.\n- `400 process_error` — Job ended with an error. No output file available.\n- `400` — Invalid `process_id` or job does not belong to your account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "jobs",
