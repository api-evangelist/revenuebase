          "id": "7a35089a-ffa7-4da0-b477-d35bea19b96f",
          "name": "Cancel a batch job",
          "request": {
            "name": "Cancel a batch job",
            "description": {
              "content": "Marks a batch job for cancellation. Jobs in `QUEUED` state will not be processed. Jobs in `PROCESSING` state may not stop immediately.\n\n**Errors**\n- `400 already_cancelled` — Job is already `CANCELLED` or `CANCELLING`.\n- `400 not_cancellable` — Job has status `COMPLETED` or `ERROR`.\n- `400` — Invalid `process_id` or job does not belong to your account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "jobs",
