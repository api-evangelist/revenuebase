          "name": "Verify a single email address",
          "request": {
            "name": "Verify a single email address",
            "description": {
              "content": "Verifies one email address synchronously. Returns `Valid`, `Invalid`, or `Unknown`. Set `metadata=true` to include MX record presence, email provider, security gateway, and failure reason. Deducts 1 credit on `Valid` or `Invalid` results. Rate limited to 5 request per second.\n\n**Errors**\n- `402` — Insufficient credits. Recharge your account before retrying.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "email",
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
